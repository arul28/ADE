{
  "name": "@ade-dev/sdk",
  "version": "0.2.0",
  "description": "Typed Node/Electron-main client that owns a slim ADE runtime and exposes chat as durable named threads.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./electron": {
      "types": "./dist/electron/index.d.ts",
      "import": "./dist/electron/index.js",
      "require": "./dist/electron/index.cjs"
    },
    "./electron/preload": {
      "types": "./dist/electron/preload.d.ts",
      "import": "./dist/electron/preload.js",
      "require": "./dist/electron/preload.cjs"
    },
    "./electron/renderer": {
      "types": "./dist/electron/renderer.d.ts",
      "import": "./dist/electron/renderer.js",
      "require": "./dist/electron/renderer.cjs"
    },
    "./electron/renderer.global.js": "./dist/electron/renderer.global.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arul28/ADE.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/arul28/ADE/tree/main/packages/sdk",
  "bugs": {
    "url": "https://github.com/arul28/ADE/issues"
  },
  "keywords": [
    "ade",
    "sdk",
    "agent",
    "chat",
    "mcp",
    "claude",
    "electron"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "vitest run test/live.integration.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^0.34.6"
  }
}
