# Auto detect text files and perform LF normalization
* text=auto
# Shell scripts keep LF everywhere. The Windows package is built on a Windows
# runner, whose checkout would turn them into CRLF, and Git Bash then fails on
# the packaged POSIX `ade` wrapper.
*.sh text eol=lf
# Built from remoteMcpApp/*.ts and app.css by scripts/generate-remote-mcp-app.mjs.
apps/ade-cli/src/services/remoteMcp/remoteMcpApp/app.generated.ts linguist-generated=true
