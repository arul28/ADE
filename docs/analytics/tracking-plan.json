        "feature",
        "outcome",
        "source"
      ]
    },
    {
      "name": "ade_mobile_sign_in_outcome",
      "platforms": [
        "ios"
      ],
      "owner": "apps/ios/ADE/Services/ProductAnalytics.swift",
