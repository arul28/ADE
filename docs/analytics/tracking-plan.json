      "source": "ios",
      "purpose": "A coarse recoverable iOS error category.",
      "properties": [
        "error_kind",
        "recoverable"
      ]
    },
    {
      "name": "ade_mobile_analytics_budget",
      "platforms": [
        "ios"
      ],
      "owner": "apps/ios/ADE/Services/ProductAnalytics.swift",
      "source": "ios",
      "purpose": "Delayed daily rollup of the phone's analytics budget.",
      "properties": [
        "sent_count",
        "dropped_count",
        "drop_reason"
      ]
    },
    {
      "name": "ade_marketing_app_opened",
