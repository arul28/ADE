;; Seatbelt profile for the ADE tool-use eval (macOS `sandbox-exec -f`).
;; Every agent process runs inside it, with its whole process tree. PATH
;; stand-ins are not enough: a login shell (`zsh -lc`) runs path_helper and
;; puts /usr/bin and /usr/sbin first, and an agent can type an absolute path.
;; This profile makes the real tools fail whatever the shell or path.
(version 1)
(allow default)

;; Tools that act on the user's real screen, apps or simulators, and the real `gh`.
(deny process-exec
  (literal "/usr/sbin/screencapture")
  (literal "/usr/bin/osascript")
  (literal "/usr/bin/osacompile")
  (literal "/usr/bin/automator")
  (literal "/usr/bin/shortcuts")
  (literal "/usr/bin/open")
  (literal "/usr/bin/xcrun")
  (literal "/usr/bin/xcodebuild")
  (regex #"/Contents/Developer/usr/bin/(xcodebuild|simctl)$")
  (regex #"/cliclick$")
  (regex #"^/(opt/homebrew|usr/local)/(bin|Cellar/gh/[^/]+/bin)/gh$")
  ;; The real ADE CLI, in every install location (Stable, Beta, Alpha).
  (regex #"^/Users/[^/]+/\.local/bin/ade")
  (regex #"^/Users/[^/]+/\.ade[^/]*/bin/")
  (regex #"^/Applications/ADE[^/]*\.app/Contents/Resources/ade-cli/")
  (regex #"/ade-cli-shims/"))

;; The same programs as data: copying one needs a read, so a copy cannot run.
(deny file-read-data
  (literal "/usr/sbin/screencapture")
  (literal "/usr/bin/osascript")
  (literal "/usr/bin/osacompile")
  (literal "/usr/bin/automator")
  (literal "/usr/bin/shortcuts")
  (literal "/usr/bin/open")
  (regex #"/cliclick$")
  (regex #"^/(opt/homebrew|usr/local)/(bin|Cellar/gh/[^/]+/bin)/gh$")
  (regex #"^/Users/[^/]+/\.ade[^/]*/bin/"))

;; The real CLI's code, so `node .../cli.cjs` cannot run it either.
(deny file-read* (regex #"^/Applications/ADE[^/]*\.app/Contents/Resources/ade-cli/"))

;; Every live brain (Stable, Beta, Alpha), its helpers and the gh token sockets.
(deny network-outbound (remote unix-socket (path-regex #"^/Users/[^/]+/\.ade[^/]*/sock/")))
