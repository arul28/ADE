{
  "v": 1,
  "title": "Journal",
  "fallback": {
    "title": "Journal",
    "text": "Open ADE on a machine that has Work Journal installed to read your notes.",
    "deeplink": "ade://plugin/journal/journal"
  },
  "body": [
    {
      "component": "stack",
      "direction": "vertical",
      "gap": "md",
      "children": [
        { "component": "text", "text": "Journal", "variant": "title" },
        {
          "component": "stack",
          "direction": "horizontal",
          "gap": "md",
          "wrap": true,
          "children": [
            {
              "component": "segmented",
              "stateKey": "range",
              "label": "When",
              "default": "today",
              "options": [
                { "value": "", "label": "All" },
                { "value": "today", "label": "Today" },
                { "value": "week", "label": "This week" }
              ]
            },
            {
              "component": "segmented",
              "stateKey": "kind",
              "label": "What",
              "default": "",
              "options": [
                { "value": "", "label": "All" },
                { "value": "blocked", "label": "Blocked" },
                { "value": "done", "label": "Done" }
              ]
            }
          ]
        },
        {
          "component": "list",
          "bind": {
            "collection": "notes",
            "limit": 100,
            "allowActions": ["deleteNote"],
            "where": [
              {
                "or": [
                  { "field": "today", "equals": { "$state": "range" } },
                  { "field": "week", "equals": { "$state": "range" } }
                ]
              },
              { "field": "kind", "equals": { "$state": "kind" } }
            ]
          },
          "emptyText": "No notes match this filter."
        },
        {
          "component": "stack",
          "direction": "horizontal",
          "gap": "sm",
          "wrap": true,
          "children": [
            {
              "component": "button",
              "label": "Write my standup",
              "kind": "primary",
              "icon": "sparkle",
              "onPress": { "action": "writeStandup" }
            },
            {
              "component": "button",
              "label": "Add a note",
              "kind": "default",
              "icon": "note",
              "onPress": { "action": "addNoteToLane" }
            }
          ]
        }
      ]
    }
  ]
}
