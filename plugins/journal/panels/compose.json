{
  "v": 1,
  "title": "Add a note",
  "fallback": {
    "title": "Add a note",
    "text": "Open ADE on a machine that has Work Journal installed to add a note.",
    "deeplink": "ade://plugin/journal/compose"
  },
  "body": [
    {
      "component": "stack",
      "direction": "vertical",
      "gap": "md",
      "children": [
        { "component": "text", "text": "Add a note", "variant": "title" },
        { "component": "keyValue", "bind": { "collection": "$context" }, "emptyText": "No lane — this note will be untagged." },
        {
          "component": "form",
          "fields": [
            {
              "kind": "text",
              "id": "text",
              "label": "Note",
              "placeholder": "fixed the login redirect",
              "help": "One line. This is what your standup will read out."
            },
            {
              "kind": "select",
              "id": "kind",
              "label": "Tag",
              "options": [
                { "value": "note", "label": "Just a note" },
                { "value": "done", "label": "Done" },
                { "value": "blocked", "label": "Blocked" }
              ]
            }
          ],
          "submit": { "label": "Save note", "onPress": { "action": "submitNote" } }
        }
      ]
    }
  ]
}
