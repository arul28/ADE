{
  "v": 1,
  "title": "Decision Log",
  "fallback": {
    "title": "Decision Log",
    "text": "Open ADE on a computer to change the weekly digest.",
    "deeplink": "ade://plugin/decision-log/log"
  },
  "body": [
    {
      "component": "stack",
      "direction": "vertical",
      "gap": "md",
      "children": [
        {
          "component": "segmented",
          "stateKey": "digestEnabled",
          "label": "Weekly digest",
          "style": "toggle",
          "default": "off",
          "options": [
            { "value": "off", "label": "Off" },
            { "value": "on", "label": "On" }
          ],
          "onChange": { "action": "applyDigestSettings" }
        },
        {
          "component": "text",
          "variant": "caption",
          "text": "Turn this on for a weekly notification summarizing what you logged."
        }
      ]
    }
  ]
}
