{
  "v": 1,
  "title": "Decisions",
  "fallback": {
    "title": "Decisions",
    "text": "Open ADE to read your decision log.",
    "deeplink": "ade://plugin/decision-log/log"
  },
  "body": [
    {
      "component": "stack",
      "direction": "vertical",
      "gap": "md",
      "children": [
        {
          "component": "stack",
          "direction": "horizontal",
          "gap": "md",
          "wrap": true,
          "children": [
            {
              "component": "segmented",
              "stateKey": "range",
              "label": "When",
              "default": "",
              "options": [
                { "value": "", "label": "All" },
                { "value": "-7d", "label": "Last 7 days" },
                { "value": "-30d", "label": "Last 30 days" }
              ]
            }
          ]
        },
        {
          "component": "list",
          "emptyText": "No decisions yet. Press \"Log decision\" at the top of any chat.",
          "bind": {
            "collection": "decisions",
            "keyPrefix": "dec:",
            "limit": 100,
            "allowActions": ["reverseDecision", "unreverseDecision"],
            "where": [
              { "field": "at", "since": { "$state": "range" } },
              { "field": "laneId", "equals": { "$state": "lane" } }
            ]
          }
        }
      ]
    }
  ]
}
