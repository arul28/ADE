{
  "protocolVersion": 1,
  "agentInfo": {
    "name": "qwen-code",
    "title": "Qwen Code",
    "version": "0.24.0"
  },
  "authMethods": [
    {
      "id": "openai",
      "name": "Use OpenAI API key",
      "description": "Requires setting the `OPENAI_API_KEY` environment variable",
      "_meta": {
        "type": "terminal",
        "args": [
          "--auth-type=openai"
        ]
      }
    },
    {
      "id": "openai-responses",
      "name": "Use OpenAI Responses API key",
      "description": "Requires setting the `OPENAI_API_KEY` environment variable",
      "_meta": {
        "type": "terminal",
        "args": [
          "--auth-type=openai-responses"
        ]
      }
    }
  ],
  "agentCapabilities": {
    "loadSession": true,
    "promptCapabilities": {
      "image": true,
      "audio": true,
      "embeddedContext": true
    },
    "sessionCapabilities": {
      "list": {},
      "resume": {}
    },
    "mcpCapabilities": {
      "sse": true,
      "http": true
    },
    "_meta": {
      "imageCapability": {
        "autoHandlesWrongModel": true,
        "maxBytes": 10380902,
        "maxImagesPerTurn": 4
      }
    }
  }
}
