{
  "name": "hello-plugin",
  "version": "0.1.0",
  "displayName": "Hello",
  "description": "Fixture plugin: exercises the SDK, a CLI word, a collection and a socket contribution.",
  "icon": "sparkle",
  "accent": "#7C6FF0",
  "vocabVersion": 1,
  "entry": "index.js",
  "surfaces": [
    { "kind": "tab", "id": "hello", "title": "Hello", "panelId": "main" }
