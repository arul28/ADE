<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Default-on product analytics, masked session replay (PostHog) and error mirroring; signed-in activity is linked only through a pseudonymous account hash. -->
	<!-- Sponsored cards (Gravity, ADE Cloud Free chats, after the person agrees): ADE's server sends Gravity the chat's last messages,
	     IP and device, scrambled account and chat ids and, only when Apple's tracking prompt was allowed, a SHA-256 email hash.
	     That is tracking, so it is declared. The two domains below are the ones that receive the email hash; only ADE's server
	     calls them (the app itself loads just the shown card's view and click links from trygravity.ai). -->
	<key>NSPrivacyTracking</key>
	<true/>
	<key>NSPrivacyTrackingDomains</key>
	<array>
		<string>server.trygravity.ai</string>
		<string>index.trygravity.com</string>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
