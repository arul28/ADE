{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ade-github-webhook-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-30",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // Public (PKCE) client id of the ADE Linear app; refreshes Linear agent app tokens.
    "LINEAR_APP_CLIENT_ID": "e552c738cd63ea5967f08bbc9c09b54c",
    // The desktop app's public Clerk OAuth client (account tokens carry it as client_id).
    "CLERK_EXTRA_OAUTH_CLIENT_IDS": "Az7TbviBocyXjZk1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO_EVENTS",
        "class_name": "RepoEventsDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepoEventsDurableObject"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ade-github-relay",
      "database_id": "65e81b4d-2894-444f-9546-390815533b3b",
      "migrations_dir": "migrations"
    }
  ]
}
