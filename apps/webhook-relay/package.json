{
  "name": "ade-webhook-relay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run d1:migrate:remote && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply ade-github-relay --local",
    "d1:migrate:remote": "wrangler d1 migrations apply ade-github-relay --remote",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260620.0",
    "@types/node": "^20.11.30",
    "typescript": "^5.7.3",
    "vitest": "^0.34.6",
    "wrangler": "^4.53.0"
  }
}
