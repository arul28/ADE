{
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000"
        }
      ]
    },
    {
      "source": "/film/((?!film\\.json$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000"
        }
      ]
    },
    {
      "source": "/assets/(.+-[A-Za-z0-9_-]{8}\\.[a-z0-9]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/demo/assets/(.+-[A-Za-z0-9_-]{8}\\.[a-z0-9]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/_t/static/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/_t/array/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/array/:path"
    },
    {
      "source": "/_t/:path(.*)",
      "destination": "https://us.i.posthog.com/:path"
    },
    {
      "source": "/docs",
      "destination": "https://ade-ac1c6011.mintlify.dev/docs"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://ade-ac1c6011.mintlify.dev/docs/:match*"
    },
    {
      "source": "/open",
      "destination": "/api/open"
    },
    {
      "source": "/install.sh",
      "destination": "/api/install?script=sh"
    },
    {
      "source": "/install.ps1",
      "destination": "/api/install?script=ps1"
    },
    {
      "source": "/download/brain/:target",
      "destination": "/api/download?kind=brain&target=:target"
    },
    {
      "source": "/download/:slug",
      "destination": "/api/download?kind=app&slug=:slug"
    },
    {
      "source": "/device",
      "destination": "/api/device"
    },
    {
      "source": "/pair",
      "destination": "/pair/index.html"
    },
    {
      "source": "/pair/",
      "destination": "/pair/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
