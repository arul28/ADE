{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ade-tunnel-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-30",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNEL",
        "class_name": "TunnelDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TunnelDurableObject"]
    }
  ]
}
