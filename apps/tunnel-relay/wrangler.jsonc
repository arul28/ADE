{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ade-tunnel-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-30",
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Persistent, queryable logs in the dashboard (Workers → ade-tunnel-relay →
  // Logs): host_registered / connect_rejected / auth_failed lifecycle events.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNEL",
        "class_name": "TunnelDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TunnelDurableObject"]
    }
  ]
}
