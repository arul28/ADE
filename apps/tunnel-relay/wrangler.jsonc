{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ade-tunnel-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Public Sentry DSN of the ade-workers project. Not a secret (it only lets
  // events in). SENTRY_RELEASE is set at deploy, not here.
  "vars": {
    "SENTRY_DSN": "https://7b05312b178df4f7d294794aa9ff7cde@o4512249455640576.ingest.us.sentry.io/4512249615024128",
    // This config is the deployed one, so it reports as `production`.
    // `npm run dev` passes `development`, which src/sentry.ts never sends.
    "SENTRY_ENVIRONMENT": "production"
  },
  // Persistent, queryable logs in the dashboard (Workers → ade-tunnel-relay →
  // Logs): host_registered / connect_rejected / auth_failed lifecycle events.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNEL",
        "class_name": "TunnelDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TunnelDurableObject"]
    }
  ]
}
