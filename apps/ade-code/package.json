    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vitest": "^0.34.6"
