{
  "name": "ade-cli",
  "version": "0.0.0",
  "description": "Agent-focused command-line interface for ADE",
  "type": "module",
  "bin": {
    "ade": "dist/cli.cjs"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "cli:dev": "npm run build --silent && node dist/cli.cjs",
    "dev": "tsx src/cli.ts",
    "build": "tsup && node ./scripts/verify-built-cli.mjs",
    "build:static": "node ./scripts/build-static.mjs",
    "notarize:static": "node ./scripts/notarize-static-runtime.mjs",
    "package:native-deps": "node ./scripts/package-native-deps.mjs",
    "tools:manifest": "node ./scripts/generate-tools-manifest.mjs",
    "tools:manifest:check": "node ./scripts/generate-tools-manifest.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@cursor/sdk": "1.0.23",
    "@factory/droid-sdk": "0.2.0",
    "@linear/sdk": "^84.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "0.144.5",
    "@opencode-ai/sdk": "1.18.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "bonjour-service": "^1.3.0",
    "chokidar": "^4.0.3",
    "highlight.js": "^11.11.1",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "jose": "^6.2.3",
    "marked": "^18.0.3",
    "node-cron": "^3.0.3",
    "node-pty": "^1.1.0",
    "opencode-ai": "1.18.14",
    "react": "^19.2.7",
    "string-width": "^4.2.3",
    "ws": "^8.20.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "ink-testing-library": "^4.0.0",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vitest": "^0.34.6"
  }
}
