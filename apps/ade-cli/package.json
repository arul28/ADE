{
  "name": "ade-cli",
  "version": "0.0.0",
  "description": "Agent-focused command-line interface for ADE",
  "type": "module",
  "bin": {
    "ade": "dist/cli.cjs"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "cli:dev": "npm run build --silent && node dist/cli.cjs",
    "dev": "tsx src/cli.ts",
    "build": "tsup && node ./scripts/verify-built-cli.mjs",
    "build:static": "node ./scripts/build-static.mjs",
    "notarize:static": "node ./scripts/notarize-static-runtime.mjs",
    "package:native-deps": "node ./scripts/package-native-deps.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.20.0",
    "@anthropic-ai/claude-agent-sdk": "^0.2.119",
    "@cursor/sdk": "^1.0.9",
    "@linear/sdk": "^84.0.0",
    "@openai/codex": "0.130.0",
    "@opencode-ai/sdk": "^1.4.2",
    "@wize-logic/nodejs-rfb": "^4.2.0",
    "bonjour-service": "^1.3.0",
    "chokidar": "^4.0.3",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "node-cron": "^3.0.3",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "sql.js": "^1.13.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.28",
    "@types/ws": "^8.18.1",
    "ink-testing-library": "^4.0.0",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vitest": "^0.34.6"
  }
}
