{
  "name": "ade-cli",
  "version": "0.0.0",
  "description": "Agent-focused command-line interface for ADE",
  "type": "module",
  "bin": {
    "ade": "dist/cli.cjs"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "cli:dev": "npm run build --silent && node dist/cli.cjs",
    "dev": "tsx src/cli.ts",
    "build": "tsup && node ./scripts/verify-built-cli.mjs",
    "build:static": "node ./scripts/build-static.mjs",
    "notarize:static": "node ./scripts/notarize-static-runtime.mjs",
    "package:native-deps": "node ./scripts/package-native-deps.mjs",
    "tools:manifest": "node ./scripts/generate-tools-manifest.mjs",
    "tools:manifest:check": "node ./scripts/generate-tools-manifest.mjs --check",
    "tools:muse-pin": "node ./scripts/pin-muse-release.mjs",
    "tools:pin": "node ./scripts/pin-tool.mjs",
    "mcp-app:build": "node ./scripts/generate-remote-mcp-app.mjs",
    "mcp-app:check": "node ./scripts/generate-remote-mcp-app.mjs --check",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "pretest": "npm run tools:manifest:check && npm run mcp-app:check",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@cursor/sdk": "1.0.40",
    "@factory/droid-sdk": "0.10.0",
    "@linear/sdk": "^84.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "0.164.0",
    "@opencode/cli": "2.2.5",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "bonjour-service": "^1.3.0",
    "chokidar": "^4.0.3",
    "jose": "^6.2.3",
    "node-cron": "^3.0.3",
    "node-pty": "^1.1.0",
    "string-width": "^4.2.3",
    "ws": "^8.20.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@muse-code/sdk": "1.4.7",
    "@opencode/client": "2.0.29",
    "@sentry/node": "11.7.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "esbuild": "0.27.3",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^0.34.6"
  }
}
