{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ade-push-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-30",
  "workers_dev": true,
  "preview_urls": false,
  // Persistent, queryable request logs in the dashboard (Workers → ade-push-relay
  // → Logs). Every rate_limited / budget_exceeded / auth_failed / apns_error /
  // claim_conflict event is a structured JSON line filterable there.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Hourly prune of expired suppression / registration / rate-limit rows,
  // independent of request traffic (see the scheduled handler in index.ts).
  "triggers": { "crons": ["17 * * * *"] },
  // REQUIRED SECRET — DIRECTORY_AUTH_SECRET
  // Not a var: it is a credential, so it is set out of band and never committed.
  //   wrangler secret put DIRECTORY_AUTH_SECRET
  // Must hold the SAME value as ade-account-directory's secret of that name. It
  // is the only provenance the relay can verify on POST
  // /attention/account/machines/<key>/pairing — the one route whose effect is to
  // UN-revoke a machine, which a removed machine's still-valid account token
  // must never be enough to do on its own. A Cloudflare service binding leaves
  // no attestable marker on the inbound request, so the directory presents this
  // header over whichever transport it uses. Unset fails closed (503), and
  // `npm run deploy` refuses to ship without it (verify:auth-preflight).
  //
  // Spend + abuse controls. Change these without a code change; redeploy to apply.
  // DAILY_REQUEST_BUDGET is the hard daily request ceiling (the ~$10-ceiling
  // backstop — see DEFAULT_DAILY_REQUEST_BUDGET in relay.ts for the math).
  "vars": {
    "DAILY_REQUEST_BUDGET": "500000",
    "IP_RATE_LIMIT_PER_MIN": "120",
    "CLAIM_RATE_LIMIT_PER_MIN": "10",
    "WEB_CLIENT_ORIGIN": "https://app.ade-app.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ade-push-relay",
      "database_id": "1fab2e8a-b269-4618-9402-7a49f9651f26",
      "migrations_dir": "migrations"
    }
  ]
}
