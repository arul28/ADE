{
  "name": "ade-account-directory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "d1:migrate:local": "wrangler d1 migrations apply ade-account-directory --local",
