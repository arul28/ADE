    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260630.1",
    "@types/node": "^20.11.30",
    "typescript": "^5.7.3",
    "vitest": "^0.34.6",
    "wrangler": "4.105.0"
  }
}
