{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ade-account-directory",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // The Sentry cron monitor `account-directory-cleanup` repeats this schedule
  // (CLEANUP_MONITOR_CONFIG in src/index.ts); change both together.
  "triggers": { "crons": ["* * * * *"] },
  // REQUIRED SECRET — DIRECTORY_AUTH_SECRET
  // Not a var: it is a credential, so it is set out of band and never committed.
  //   wrangler secret put DIRECTORY_AUTH_SECRET            # this worker
  //   wrangler secret put DIRECTORY_AUTH_SECRET            # ade-push-relay
  // Both workers must hold the SAME value. It proves to the relay that a machine
  // membership change came from this worker rather than from a removed machine
  // replaying the account token it still holds — the token alone cannot be
  // trusted to un-revoke a machine. Unset on either side fails closed: machine
  // removal reports 502 and re-pairing is refused.
  // Repeat the secret for `env.production` (`wrangler secret put --env production`).
  //
  // OPTIONAL SECRET — CLERK_SECRET_KEY
  // The Clerk Backend API key of the Clerk instance this worker uses. Only
  // `/device/approve` reads it, to mint the one-time sign-in ticket for a user
  // who approved a sign-in from a signed-in ADE app. Unset, that route answers
  // 503 and the app opens the browser page instead. It can sign in as any user
  // of that instance, so it is set out of band like the secret above.
  //
  // REQUIRED SECRET — AGENT37_API_KEY (ADE Cloud)
  // The workspace key ADE Cloud runs computers on, set out of band like the
  // secret above. Only this Worker holds it: the desktop and brains never do.
  // Without it every /cloud route refuses with 503 and the cron does nothing.
  //
  // OPTIONAL SECRET — RESEND_API_KEY (ADE Cloud)
  // Sends hours warnings, deletion warnings and owner alerts. Unset, those log
  // a line and carry on. Recipients come from CLERK_SECRET_KEY above.
  //
  // SECRETS — STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (ADE Cloud)
  // The Stripe key that sells the plan, and the `whsec_...` signing secret of the
  // webhook endpoint pointing at https://<this worker>/webhooks/stripe, subscribed
  // to checkout.session.completed, customer.subscription.updated and .deleted,
  // invoice.paid and invoice.payment_failed. Set out of band. Without them the
  // billing routes answer 503, the webhook answers 503, and no hours are reported.
  //
  // CLOUD_ACCESS_ACCOUNTS (ADE Cloud, deliberately absent below)
  // A comma list of Clerk user ids, or `*`. Unset means nobody: every /cloud
  // route answers 404. The owner's id is set at rollout, out of band.
  //
  // SECRET — CLOUD_CHAT_MASTER_KEY (ADE Cloud, saved chats)
  // 32 random bytes, base64 (`openssl rand -base64 32`). Seals the per-user key
  // that encrypts saved chats. Set out of band. Rotating it makes existing saved
  // chats unreadable, so it is never rotated in place. Unset, the chat routes
  // answer 503.
  //
  // OPTIONAL SECRETS — CLERK_WEBHOOK_SIGNING_SECRET, POSTHOG_PROJECT_TOKEN
  // `/webhooks/clerk` records one `ade_signed_up` PostHog event per new account
  // (src/signupAnalytics.ts). Create a Clerk webhook for `user.created` and `user.deleted` pointing
  // at https://<this worker>/webhooks/clerk, then set its `whsec_…` signing
  // secret and the public `phc_…` project token. Unset, the route answers 503 (a `user.deleted` needs only the signing secret).
  "vars": {
    "ONLINE_WINDOW_MS": "150000",
    // Public Sentry DSN of the ade-workers project. Not a secret (it only lets
    // events in). SENTRY_RELEASE is set at deploy, not here. No
    // SENTRY_ENVIRONMENT here: this development Worker and `wrangler dev`
    // report as `development`, which src/sentry.ts never sends.
    "SENTRY_DSN": "https://7b05312b178df4f7d294794aa9ff7cde@o4512249455640576.ingest.us.sentry.io/4512249615024128",
    // Exact hosted web-client origin allowed to read /account/machines.
    // Set to the production HTTPS origin before deployment.
    "WEB_CLIENT_ORIGIN": "https://app.ade-app.dev",
    // Push relay origin. Removing a machine forwards the removal here so its
    // Activity is purged and it cannot publish again; a machine removal fails
    // loudly (502) when this is unset or unreachable.
    //
    // PUSH_RELAY_URL builds the request URL; the `ACTIVITY_RELAY` service
    // binding below carries it. Both are required, and so is
    // DIRECTORY_AUTH_SECRET, because a service binding carries no provenance
    // the relay can verify.
    "PUSH_RELAY_URL": "https://ade-push-relay.arulsharma1028.workers.dev",
    // Fleet-wide diagnostic uploads STORED per UTC day. This Worker is the only
    // writer the diagnostics bucket has, so this number is the storage bill:
    // 400 × 512 KB × the bucket's 30-day expiry lifecycle ≈ 6 GB steady state,
    // inside R2's 10 GB free tier. Clients auto-send reports on failure, so
    // raising it is a deliberate act with arithmetic attached (README,
    // "Diagnostic report uploads"). `0` stops every upload without a code
    // deploy; unset or unparseable falls back to the same 400.
    "DIAGNOSTICS_DAILY_GLOBAL_LIMIT": "400",
    // Daily usage research reports (`POST /usage-research/daily`), stored in
    // the D1 database below, which ALSO holds machines and sign-in state. A
    // full database refuses every write, so these three bound what research
    // data can ever take (README, "Usage research reports"):
    //   - writes that change a row, fleet-wide, per UTC day (`0` stops them);
    //   - days of reports the cron keeps (never below 9, the accepted window);
    //   - report megabytes the table may hold in total (`0` stops growth; the
    //     Worker clamps anything above 6144).
    // Unset or unparseable falls back to the same values.
    "USAGE_RESEARCH_DAILY_GLOBAL_LIMIT": "20000",
    "USAGE_RESEARCH_RETENTION_DAYS": "180",
    "USAGE_RESEARCH_STORAGE_CEILING_MB": "4096",
    // Model registry refresh (`GET /router/registry`, README, "Model
    // registry"). The cron fetches two Artificial Analysis pages and models.dev
    // once a day. Artificial Analysis terms restrict automated collection; the
    // owner accepted that risk for the router. `0` stops every fetch at once,
    // and the stored snapshots keep serving. Unset means on.
    "MODEL_REGISTRY_REFRESH": "1",
    // Apple Music developer tokens (`GET /music/developer-token`, README,
    // "Apple Music developer tokens"). The key itself is the secret
    // MUSICKIT_PRIVATE_KEY (the .p8 file's PEM text), set out of band:
    //   wrangler secret put MUSICKIT_PRIVATE_KEY < AuthKey_3NNQ5Y43RA.p8
    // Without it the route answers 503 and the Music tab says it is unavailable;
    // nothing else on this Worker depends on it.
    "MUSICKIT_KEY_ID": "3NNQ5Y43RA",
    "MUSICKIT_TEAM_ID": "VQ372F39G6",
    "MUSICKIT_TOKEN_TTL_SECONDS": "2592000",
    // ADE Cloud prices and meter in the Stripe SANDBOX. `scripts/stripe-setup.mjs`
    // creates or finds them and prints these ids.
    "STRIPE_PLAN_PRICE_ID": "price_1UZkLZBsy4QVYccDJhyDhBPZ",
    "STRIPE_EXTRA_PRICE_ID": "price_1UZkLZBsy4QVYccDDwJ33ruZ",
    "STRIPE_METER_EVENT": "ade_cloud_small_hours",
    // Pro, extra disk (its own meter, never the hours price) and the billing
    // portal setup (card, cancel, invoices). Same script, same sandbox.
    "STRIPE_PRO_PRICE_ID": "price_1UaJv6Bsy4QVYccDyUbQTq6x",
    "STRIPE_DISK_PRICE_ID": "price_1UaJujBsy4QVYccDV5I9JPx0",
    "STRIPE_DISK_METER_EVENT": "ade_cloud_extra_disk_gb_days",
    "STRIPE_PORTAL_CONFIG_ID": "bpc_1UaJvHBsy4QVYccDU70Jf6tD"
  },
  // REQUIRED, not optional. Cloudflare refuses a Worker's fetch to another
  // Worker of the same account through its workers.dev URL (error 1042): the
  // edge answers 404 and the relay never sees the request. Without this
  // binding, every re-pair answered 503 and every machine removal failed
  // (2026-09-23). Environments do not inherit it, so production repeats it.
  "services": [{ "binding": "ACTIVITY_RELAY", "service": "ade-push-relay" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ade-account-directory",
      "database_id": "215bebd4-6601-4705-ab6e-e6f2d1397156",
      "migrations_dir": "migrations"
    }
  ],
  // Opt-in diagnostic report uploads (`POST /diagnostics/upload`). The bucket
  // is NOT created by deploying — run `wrangler r2 bucket create` first (see
  // README, "Diagnostic report uploads"). Missing binding is handled: the route
  // answers 503 and the in-app button reports that sending is unavailable.
  "r2_buckets": [
    {
      "binding": "DIAGNOSTICS",
      "bucket_name": "ade-diagnostics"
    },
    // ADE Cloud saved chats (src/cloud/chats.ts). The bucket is NOT created by
    // deploying: run `wrangler r2 bucket create ade-cloud-chats` at rollout. A
    // missing binding is handled: the chat routes answer 503.
    {
      "binding": "CLOUD_CHATS",
      "bucket_name": "ade-cloud-chats"
    }
  ],
  "env": {
    "production": {
      "name": "ade-account-directory-production",
      // DIRECTORY_AUTH_SECRET is required here too and is set as a secret:
      //   wrangler secret put DIRECTORY_AUTH_SECRET --env production
      "vars": {
        // The page a person opens to confirm a sign-in. `ade-app.dev/device`
        // opens the ADE phone app as a universal link, and redirects a browser
        // to this worker's `/device`. Production only: that page redirects to
        // the production worker. Deploy the website before this worker, or
        // every sign-in link is a 404; the deploy preflight checks the page
        // is live (`scripts/verify-deployment-config.mjs`).
        "DEVICE_PAGE_ORIGIN": "https://ade-app.dev",
        "ONLINE_WINDOW_MS": "150000",
        // Same public DSN as above; vars do not inherit into an environment.
        "SENTRY_DSN": "https://7b05312b178df4f7d294794aa9ff7cde@o4512249455640576.ingest.us.sentry.io/4512249615024128",
        // The only environment Sentry hears from (src/sentry.ts drops the rest).
        "SENTRY_ENVIRONMENT": "production",
        "WEB_CLIENT_ORIGIN": "https://app.ade-app.dev",
        "PUSH_RELAY_URL": "https://ade-push-relay.arulsharma1028.workers.dev",
        // Same ceiling as the default environment, and set explicitly: wrangler
        // environments do not inherit `vars`, so an omission here would silently
        // fall back to the code default rather than to the value above.
        "DIAGNOSTICS_DAILY_GLOBAL_LIMIT": "400",
        // Usage research bounds, restated for the same reason.
        "USAGE_RESEARCH_DAILY_GLOBAL_LIMIT": "20000",
        "USAGE_RESEARCH_RETENTION_DAYS": "180",
        "USAGE_RESEARCH_STORAGE_CEILING_MB": "4096",
        // Model registry refresh switch, restated for the same reason.
        "MODEL_REGISTRY_REFRESH": "1",
        // Apple Music token ids, restated for the same reason. The key is a
        // secret here too: wrangler secret put MUSICKIT_PRIVATE_KEY --env production
        "MUSICKIT_KEY_ID": "3NNQ5Y43RA",
        "MUSICKIT_TEAM_ID": "VQ372F39G6",
        "MUSICKIT_TOKEN_TTL_SECONDS": "2592000"
        // STRIPE_PLAN_PRICE_ID, STRIPE_PRO_PRICE_ID, STRIPE_EXTRA_PRICE_ID,
        // STRIPE_METER_EVENT, STRIPE_DISK_PRICE_ID, STRIPE_DISK_METER_EVENT and
        // STRIPE_PORTAL_CONFIG_ID are left out until rollout: run
        // `scripts/stripe-setup.mjs` with the live key and put the ids it prints
        // here. Unset, billing answers 503 (Pro and extra disk: only those).
      },
      "services": [{ "binding": "ACTIVITY_RELAY", "service": "ade-push-relay" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ade-account-directory-production",
          "database_id": "38ebe0bb-ac4d-4b39-b73e-bab2f0092971",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DIAGNOSTICS",
          "bucket_name": "ade-diagnostics-production"
        },
        // Saved chats: created at rollout (`wrangler r2 bucket create ade-cloud-chats-production`).
        {
          "binding": "CLOUD_CHATS",
          "bucket_name": "ade-cloud-chats-production"
        }
      ]
    }
  }
}
