{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ade-account-directory",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-30",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["* * * * *"] },
  // REQUIRED SECRET — DIRECTORY_AUTH_SECRET
  // Not a var: it is a credential, so it is set out of band and never committed.
  //   wrangler secret put DIRECTORY_AUTH_SECRET            # this worker
  //   wrangler secret put DIRECTORY_AUTH_SECRET            # ade-push-relay
  // Both workers must hold the SAME value. It proves to the relay that a machine
  // membership change came from this worker rather than from a removed machine
  // replaying the account token it still holds — the token alone cannot be
  // trusted to un-revoke a machine. Unset on either side fails closed: machine
  // removal reports 502 and re-pairing is refused.
  // Repeat the secret for `env.production` (`wrangler secret put --env production`).
  "vars": {
    "ONLINE_WINDOW_MS": "90000",
    // Exact hosted web-client origin allowed to read /account/machines.
    // Set to the production HTTPS origin before deployment.
    "WEB_CLIENT_ORIGIN": "https://app.ade-app.dev",
    // Push relay origin. Removing a machine forwards the removal here so its
    // Activity is purged and it cannot publish again; a machine removal fails
    // loudly (502) when this is unset or unreachable.
    //
    // PUSH_RELAY_URL builds the request URL; the `ACTIVITY_RELAY` service
    // binding below carries it. Both are required, and so is
    // DIRECTORY_AUTH_SECRET, because a service binding carries no provenance
    // the relay can verify.
    "PUSH_RELAY_URL": "https://ade-push-relay.arulsharma1028.workers.dev",
    // Fleet-wide diagnostic uploads STORED per UTC day. This Worker is the only
    // writer the diagnostics bucket has, so this number is the storage bill:
    // 400 × 512 KB × the bucket's 30-day expiry lifecycle ≈ 6 GB steady state,
    // inside R2's 10 GB free tier. Clients auto-send reports on failure, so
    // raising it is a deliberate act with arithmetic attached (README,
    // "Diagnostic report uploads"). `0` stops every upload without a code
    // deploy; unset or unparseable falls back to the same 400.
    "DIAGNOSTICS_DAILY_GLOBAL_LIMIT": "400",
    // Daily usage research reports (`POST /usage-research/daily`), stored in
    // the D1 database below, which ALSO holds machines and sign-in state. A
    // full database refuses every write, so these three bound what research
    // data can ever take (README, "Usage research reports"):
    //   - writes that change a row, fleet-wide, per UTC day (`0` stops them);
    //   - days of reports the cron keeps (never below 9, the accepted window);
    //   - report megabytes the table may hold in total (`0` stops growth; the
    //     Worker clamps anything above 6144).
    // Unset or unparseable falls back to the same values.
    "USAGE_RESEARCH_DAILY_GLOBAL_LIMIT": "20000",
    "USAGE_RESEARCH_RETENTION_DAYS": "180",
    "USAGE_RESEARCH_STORAGE_CEILING_MB": "4096"
  },
  // REQUIRED, not optional. Cloudflare refuses a Worker's fetch to another
  // Worker of the same account through its workers.dev URL (error 1042): the
  // edge answers 404 and the relay never sees the request. Without this
  // binding, every re-pair answered 503 and every machine removal failed
  // (2026-09-23). Environments do not inherit it, so production repeats it.
  "services": [{ "binding": "ACTIVITY_RELAY", "service": "ade-push-relay" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ade-account-directory",
      "database_id": "215bebd4-6601-4705-ab6e-e6f2d1397156",
      "migrations_dir": "migrations"
    }
  ],
  // Opt-in diagnostic report uploads (`POST /diagnostics/upload`). The bucket
  // is NOT created by deploying — run `wrangler r2 bucket create` first (see
  // README, "Diagnostic report uploads"). Missing binding is handled: the route
  // answers 503 and the in-app button reports that sending is unavailable.
  "r2_buckets": [
    {
      "binding": "DIAGNOSTICS",
      "bucket_name": "ade-diagnostics"
    }
  ],
  "env": {
    "production": {
      "name": "ade-account-directory-production",
      // DIRECTORY_AUTH_SECRET is required here too and is set as a secret:
      //   wrangler secret put DIRECTORY_AUTH_SECRET --env production
      "vars": {
        "ONLINE_WINDOW_MS": "90000",
        "WEB_CLIENT_ORIGIN": "https://app.ade-app.dev",
        "PUSH_RELAY_URL": "https://ade-push-relay.arulsharma1028.workers.dev",
        // Same ceiling as the default environment, and set explicitly: wrangler
        // environments do not inherit `vars`, so an omission here would silently
        // fall back to the code default rather than to the value above.
        "DIAGNOSTICS_DAILY_GLOBAL_LIMIT": "400",
        // Usage research bounds, restated for the same reason.
        "USAGE_RESEARCH_DAILY_GLOBAL_LIMIT": "20000",
        "USAGE_RESEARCH_RETENTION_DAYS": "180",
        "USAGE_RESEARCH_STORAGE_CEILING_MB": "4096"
      },
      "services": [{ "binding": "ACTIVITY_RELAY", "service": "ade-push-relay" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ade-account-directory-production",
          "database_id": "38ebe0bb-ac4d-4b39-b73e-bab2f0092971",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DIAGNOSTICS",
          "bucket_name": "ade-diagnostics-production"
        }
      ]
    }
  }
}
